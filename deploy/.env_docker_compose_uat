# Compose-level variables for UAT -- consumed by the `docker compose` CLI for
# ${...} substitution in docker-compose.yaml. NOT the application's .env, and
# nothing in here is secret (see SECRETS.md). scp'd to
# /opt/apps/edocket/uat/.env_docker_compose by the Jenkins deploy stage.
# Directories are created on first `compose up` and chowned at container start
# (see the QAT file for why the pipeline must not create them, and for what the
# secrets settings mean).
EDOCKET_APP_PORT=8012
EDOCKET_APP_STORAGE=/opt/apps/edocket/uat/documents
EDOCKET_APP_LOGS=/opt/apps/edocket/uat/logs

SECRETS_VAULT=kv-ose-shared-nonprod
AZURE_AUTH=arc
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
EDOCKET_IDENTITY_DIR=/opt/apps/edocket/uat/identity
SECRETS_REFRESH_SECONDS=0
