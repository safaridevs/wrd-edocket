# Compose-level variables for QAT -- consumed by the `docker compose` CLI for
# ${...} substitution in docker-compose.yaml. NOT the application's .env, and
# nothing in here is secret: the secrets come from Azure Key Vault at container
# start (see SECRETS.md). scp'd to /opt/apps/edocket/qat/.env_docker_compose by
# the Jenkins deploy stage.
#
# The non-prod host is shared with wrats2 (block 8000). E-Docket owns block
# 8010; offset +1 is QAT, +2 is UAT. See ~/ose-engineering/port-register.md.
#
# The storage and log directories are created by Docker on first `compose up`
# and chowned to www-data by docker/entrypoint.sh at container start. The
# pipeline deliberately does NOT mkdir them: jenkins would win the race and
# leave a jenkins-owned directory the app cannot write to.
EDOCKET_APP_PORT=8011
EDOCKET_APP_STORAGE=/opt/apps/edocket/qat/documents
EDOCKET_APP_LOGS=/opt/apps/edocket/qat/logs

# --- Secrets (Azure Key Vault) -------------------------------------------
# Vault holding edocket-qat-* secrets. The secrets service reads
# https://<SECRETS_VAULT>.vault.azure.net; set AZURE_KEYVAULT_URL instead for a
# sovereign cloud, together with AZURE_KEYVAULT_RESOURCE and AZURE_AUTHORITY_HOST.
SECRETS_VAULT=kv-ose-shared-nonprod
# How the host proves who it is: arc (Azure Arc managed identity, default) or
# certificate (service principal; needs AZURE_TENANT_ID, AZURE_CLIENT_ID and
# <EDOCKET_IDENTITY_DIR>/client.pem, root-owned 0600, on the host).
AZURE_AUTH=arc
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
EDOCKET_IDENTITY_DIR=/opt/apps/edocket/qat/identity
# 0 = fetch once per container start (rotate = `docker compose restart secrets`);
# >0 = re-read the vault every N seconds and re-render, kept on failure.
SECRETS_REFRESH_SECONDS=0
