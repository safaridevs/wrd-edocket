# E-Docket application configuration for UAT.
#
# This committed file IS the template: ose_edocket.groovy ships it unrendered
# to the host as .env.template, and the `secrets` service in the compose stack
# fills each ${VAR} placeholder from Azure Key Vault secret edocket-uat-<var>
# (APP_KEY -> edocket-uat-app-key) at container start. Jenkins never holds the
# values. Everything else is plain, versioned, diffable config. See deploy/SECRETS.md.
#
# The pipeline appends APP_VERSION=<branch>-<sha> to the template.

APP_NAME='OSE E-Docket (UAT)'
APP_ENV=uat
APP_KEY=${APP_KEY}
APP_DEBUG=false
# CONFIRM: hostname once DNS exists; until then the host IP and compose port.
APP_URL=http://10.64.85.45:8012
APP_TIMEZONE=America/Denver

AUTH_GUARD=web

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# single -> storage/logs/laravel.log (bind-mounted to the host);
# stderr -> `docker logs edocket-uat`.
LOG_CHANNEL=stack
LOG_STACK=single,stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# SQL Server. The container is Linux, so integrated Windows auth is not
# available: DB_USERNAME must be a SQL login with rights on this database.
# Database names as listed on bpmstest 4 Sep 2026; the SQL login below still has to be created (deploy/SECRETS.md).
DB_CONNECTION=sqlsrv
DB_HOST=bpmstest
DB_PORT=1433
DB_DATABASE=edocket-uat
DB_USERNAME=edocket_uat
DB_PASSWORD=${DB_PASSWORD}
DB_ENCRYPT=yes
DB_TRUST_SERVER_CERTIFICATE=true

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Agency relay; unauthenticated on port 25, so no credential is bound.
# The day MAIL_PASSWORD gets a real value, add edocket-<env>-mail-password
# to the render list in ose_edocket.groovy and replace the literal here.
MAIL_MAILER=smtp
MAIL_HOST=webmail.state.nm.us
MAIL_PORT=25
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=email.e_docket_uat@ose.nm.gov
MAIL_FROM_NAME="${APP_NAME}"
MAIL_NM_WATER_EMAIL=OSE-ITSBDevelopmentTeam@state.nm.us
MAIL_TO_NAME="ose-itsbdevelopmentteam@state.nm.us"
EMAIL_DEV=OSE-ITSBDevelopmentTeam@state.nm.us
HU_CONTACT_EMAIL=OSE-ITSBDevelopmentTeam@state.nm.us
SUPPORT_EMAIL=OSE-ITSBDevelopmentTeam@state.nm.us

# Active Directory bind account. Both values come from Jenkins: the username
# was previously stored enc:-encrypted, so it is treated as a secret too.
LDAP_CONNECTION=default
LDAP_HOST=ose.frose.local
LDAP_PORT=389
LDAP_BASE_DN="dc=ose,dc=frose,dc=local"
LDAP_USERNAME=${LDAP_USERNAME}
LDAP_PASSWORD=${LDAP_PASSWORD}
LDAP_SSL=false
LDAP_TLS=false
LDAP_TIMEOUT=5
LDAP_LOGGING=true
LDAP_CACHE=false
LDAP_ENGINE=MicrosoftAD

# Bounce mailbox polled every five minutes by the scheduler.
BOUNCE_MAIL_HOST=webmail.state.nm.us
BOUNCE_MAIL_PORT=993
BOUNCE_MAIL_ENCRYPTION=ssl
BOUNCE_MAIL_USERNAME=bounces@ose.nm.gov
BOUNCE_MAIL_PASSWORD=${BOUNCE_MAIL_PASSWORD}

# The image carries python3 + pdfrw and poppler-utils.
PDF_CONVERSION_ENABLED=true
PDF_CONVERSION_PYTHON=python3
PDF_CONVERSION_SCRIPT=tools/pdf/convert.py

VITE_APP_NAME="${APP_NAME}"
